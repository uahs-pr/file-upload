// ====================== 权限JS 仅更换后端域名，删除全部管理员代码 ======================
const BACKEND_BASE = "https://w209512.pythonanywhere.com";
let userId = "";
let authorized = false;
const $ = s => document.querySelector(s);

// 生成设备唯一ID
function getUid(){
  let uid = localStorage.getItem("device_uid");
  if(!uid){
    uid = crypto.randomUUID();
    localStorage.setItem("device_uid", uid);
  }
  return uid;
}
// 授权通过 解锁页面关闭申请弹窗
function openAuth(){
  authorized = true;
  localStorage.setItem("auth_ok", "1");
  hideModal("#applyModal");
  $("#mainWrap").classList.remove("blur-lock");
}
// 撤销/拒绝权限 锁定页面弹出申请弹窗
function closeAuth(){
  authorized = false;
  localStorage.removeItem("auth_ok");
  $("#mainWrap").classList.add("blur-lock");
  showModal("#applyModal");
}
// 弹窗工具
function showModal(sel){ $(sel).classList.remove("hidden") }
function hideModal(sel){ $(sel).classList.add("hidden") }
function showTip(title, desc){
  $("#tipTitle").textContent = title;
  $("#tipDesc").textContent = desc;
  showModal("#tipModal");
}

// 仅手动点击按钮才提交申请，页面加载不会自动发起请求
async function submitApply(){
  userId = getUid();
  try{
    await fetch(`${BACKEND_BASE}/apply`, {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({userId})
    });
    showTip("提交成功", "申请已发送，请等待管理员审核");
  }catch(err){
    showTip("提交失败", "网络异常，请稍后重试");
  }
}
// 定时轮询权限状态，同步后端状态
async function checkAuthStatus(){
  userId = getUid();
  try{
    let res = await fetch(`${BACKEND_BASE}/status?userId=${userId}`);
    let data = await res.json();
    if(data.status === "allow"){
      openAuth();
    }else{
      closeAuth();
    }
  }catch(e){}
}

// 权限初始化、绑定事件
(function initAuth(){
  userId = getUid();
  if(localStorage.getItem("auth_ok") === "1"){
    authorized = true;
    hideModal("#applyModal");
    $("#mainWrap").classList.remove("blur-lock");
  }else{
    $("#mainWrap").classList.add("blur-lock");
    showModal("#applyModal");
  }
  // 3秒轮询一次权限状态
  setInterval(checkAuthStatus, 3000);

  // 按钮绑定
  $("#submitApplyBtn").onclick = submitApply;
  $("#tipCloseBtn").onclick = ()=>hideModal("#tipModal");
})();
</script>
